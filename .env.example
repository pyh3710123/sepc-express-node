NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_API_ORIGIN=http://localhost:3000
PUBLIC_WS_ORIGIN=ws://localhost:3000
DATABASE_URL=postgres://aimanju:aimanju@localhost:5432/aimanju
REDIS_URL=redis://localhost:6379
ALLOWED_WEB_ORIGINS=http://localhost:3001
WS_ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=info

# Production requires separate random secrets of at least 32 characters.
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Only non-production development may use mock SMS and AI adapters.
DEV_MOCK_EXTERNALS=true
DEV_SMS_CODE=123456
# DEV_SEED_PASSWORD=Local-demo-123!

MAX_BATCH_NODES=200
MAX_BATCH_CONNECTIONS=400
MAX_GENERATION_TASKS=20

# Reserved for provider adapters; no real service is enabled by these alone.
# OSS_REGION=
# OSS_BUCKET=
# OSS_KEY_PREFIX=
# OSS_STS_ROLE_ARN=
# OSS_PUBLIC_BASE_URL=
# AI_PROVIDER_API_KEY=
# PAYMENT_PROVIDER=
# PAYMENT_CALLBACK_BASE_URL=
# SMS_PROVIDER=
# WECHAT_APP_ID=
